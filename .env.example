# Copiá este archivo como .env dentro de la carpeta lead_agent/ (NO en la raíz)
# y completá con tus datos reales. Nunca subas el .env real a GitHub.

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=tu-proyecto-de-google-cloud
GOOGLE_CLOUD_LOCATION=us-central1
APOLLO_API_KEY=tu-api-key-de-apollo
MICROSOFT_TENANT_ID=tu-tenant-id-de-azure-ad
MICROSOFT_CLIENT_ID=tu-client-id-de-la-app-registrada
MICROSOFT_CLIENT_SECRET=tu-client-secret-de-la-app-registrada
MICROSOFT_MAILBOX=tu-correo@tudominio.com

# Opcional. Si está definida, enviar_correo redirige TODOS los envíos a esta
# dirección en vez de al lead real (el contenido del correo no cambia).
# Útil para probar el agente end-to-end sin escribirle a prospectos de verdad.
# Dejala comentada o vacía en producción.
# TEST_OVERRIDE_EMAIL=tu-correo-de-pruebas@tudominio.com
